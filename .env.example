# Salin ke .env dan isi nilainya. JANGAN commit .env (sudah di .gitignore).
# Rahasia TIDAK BOLEH berawalan NEXT_PUBLIC_ dan tidak boleh dikirim ke browser.
# Nilai asli disimpan di Vercel Environment Variables (Preview & Production terpisah).

# Neon PostgreSQL — branch staging untuk preview/staging, branch main untuk produksi
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/lakoo?sslmode=require"

# Google Gemini (ADR-002). Kosong → rencana memakai template.
GEMINI_API_KEY=""

# Rahasah untuk endpoint cron harian (dikirim sebagai Authorization: Bearer oleh Vercel Cron)
CRON_SECRET="ganti-dengan-string-random-panjang"

# Origin aplikasi (dipakai untuk CORS/redirect & validasi sesi)
APP_ORIGIN="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# Fitur AI (SPEC §6.1: non-true atau tanpa GEMINI_API_KEY → template)
AI_ENABLED="false"
AI_MODEL="gemini-2.5-flash"
AI_DAILY_CALL_LIMIT="80"
AI_STORE_DAILY_LIMIT="20"

# Hanya untuk seed lokal/preview (SPEC §10.2) — JANGAN dipakai di produksi
DEV_SEED_PASSWORD=""

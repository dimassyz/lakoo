{
  "name": "lakoo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed:demo": "node database/src/demo/seed-demo.ts",
    "db:seed:dev": "node database/src/demo/seed-dev.ts",
    "api:types": "openapi-typescript docs/api/openapi.yaml -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.104.5",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.14",
    "idb-keyval": "^6.3.0",
    "next": "^15.5.28",
    "openapi-fetch": "0.17.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "15.5.28",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
